# Copy this file to .env and edit it. Never commit .env.
# Local-development placeholders only: no real credentials, no real health data.

# --- Django ---
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- PostgreSQL (docker compose reads these too) ---
POSTGRES_DB=health_buddy
POSTGRES_USER=health_buddy
POSTGRES_PASSWORD=health_buddy_local
POSTGRES_PORT=5432
DATABASE_URL=postgres://health_buddy:health_buddy_local@localhost:5432/health_buddy
